# ============================================================
# 3. STOCK MOVEMENT  →  /api/reports/stock-movement
#
# Params:
#   startDate — optional YYYY-MM-DD
#   endDate   — optional YYYY-MM-DD
# ============================================================

### 3.1  Ledger — no date filter (all time)
GET {{host}}/api/reports/stock-movement/ledger
Accept: application/json

###

### 3.2  Ledger — full year
GET {{host}}/api/reports/stock-movement/ledger?startDate={{fullStart}}&endDate={{fullEnd}}
Accept: application/json

###

### 3.3  Ledger — Q1 only
GET {{host}}/api/reports/stock-movement/ledger?startDate={{q1Start}}&endDate={{q1End}}
Accept: application/json

###

### 3.4  Ledger — Q2 only
GET {{host}}/api/reports/stock-movement/ledger?startDate={{q2Start}}&endDate={{q2End}}
Accept: application/json

###

### 3.5  Inward only — full year
GET {{host}}/api/reports/stock-movement/inward?startDate={{fullStart}}&endDate={{fullEnd}}
Accept: application/json

###

### 3.6  Inward only — last 30 days
GET {{host}}/api/reports/stock-movement/inward?startDate={{last30Start}}&endDate={{last30End}}
Accept: application/json

###

### 3.7  Inward — filtered by supplierId (Supplier Wise Inward Report)
# Replace SUP001 with actual vendorId stored on the raw material
GET {{host}}/api/reports/stock-movement/inward?startDate={{fullStart}}&endDate={{fullEnd}}&supplierId=SUP001
Accept: application/json

###

### 3.8  Outward only — full year
GET {{host}}/api/reports/stock-movement/outward?startDate={{fullStart}}&endDate={{fullEnd}}
Accept: application/json

###

### 3.8  Outward only — Q2 only
GET {{host}}/api/reports/stock-movement/outward?startDate={{q2Start}}&endDate={{q2End}}
Accept: application/json

###


# ============================================================
# 4. BATCH MANAGEMENT  →  /api/reports/batch
#
# Params:
#   daysAhead — optional int (default 30) — expiry-alert only
# ============================================================

### 4.1  Lifecycle — all active batches
GET {{host}}/api/reports/batch/lifecycle
Accept: application/json

###

### 4.2  Expiry Alert — default (next 30 days)
GET {{host}}/api/reports/batch/expiry-alert
Accept: application/json

###

### 4.3  Expiry Alert — next 60 days
GET {{host}}/api/reports/batch/expiry-alert?daysAhead=60
Accept: application/json

###

### 4.4  Expiry Alert — next 90 days
GET {{host}}/api/reports/batch/expiry-alert?daysAhead=90
Accept: application/json

###

### 4.5  Expiry Alert — next 180 days
GET {{host}}/api/reports/batch/expiry-alert?daysAhead=180
Accept: application/json

###


# ============================================================
# 5. PRODUCTION LOG CRUD  →  /api/production-log
#
# POST/PUT body fields:
#   finishedProductId (required), finishedProductName, batchNumber
#   quantityProduced (required), outputUnit
#   productionDate (required, YYYY-MM-DD)
#   shift: MORNING | AFTERNOON | NIGHT
#   operatorName, supervisorName
#   totalRawMaterialCost, totalAdditionalCost, totalProductionCost, costPerUnit
#   status: IN_PROGRESS | COMPLETED | SCRAPPED
#   remarks
#   components: [{ rawMaterialId, rawMaterialName, quantityPlanned,
#                  quantityActual, unit, rate, amount }]
# ============================================================

### 5.1  Create production run
POST {{host}}/api/production-log
Content-Type: application/json

{
  "finishedProductId": 41,
  "finishedProductName": "Manka Poshak 50 Kg",
  "batchNumber": "BATCH-2026-001",
  "quantityProduced": 500,
  "outputUnit": "BAG",
  "productionDate": "2026-07-26",
  "shift": "MORNING",
  "operatorName": "Raju Kumar",
  "supervisorName": "Suresh Singh",
  "totalRawMaterialCost": 250000.00,
  "totalAdditionalCost": 5000.00,
  "totalProductionCost": 255000.00,
  "costPerUnit": 510.00,
  "status": "COMPLETED",
  "remarks": "Normal run, no issues",
  "components": [
    {
      "rawMaterialId": 65,
      "rawMaterialName": "Soya DOC",
      "quantityPlanned": 10000,
      "quantityActual": 9800,
      "unit": "KG",
      "rate": 39.52,
      "amount": 387296.00
    },
    {
      "rawMaterialId": 85,
      "rawMaterialName": "DORB",
      "quantityPlanned": 5000,
      "quantityActual": 5100,
      "unit": "KG",
      "rate": 20.00,
      "amount": 102000.00
    }
  ]
}

###

### 5.2  Get production log by ID=1
GET {{host}}/api/production-log/1
Accept: application/json

###

### 5.3  Update production log ID=1 — mark completed
PUT {{host}}/api/production-log/1
Content-Type: application/json

{
  "finishedProductId": 41,
  "finishedProductName": "Manka Poshak 50 Kg",
  "batchNumber": "BATCH-2026-001",
  "quantityProduced": 500,
  "outputUnit": "BAG",
  "productionDate": "2026-07-26",
  "shift": "MORNING",
  "operatorName": "Raju Kumar",
  "supervisorName": "Suresh Singh",
  "totalRawMaterialCost": 250000.00,
  "totalAdditionalCost": 5000.00,
  "totalProductionCost": 255000.00,
  "costPerUnit": 510.00,
  "status": "COMPLETED",
  "remarks": "Updated: run completed successfully"
}

###

### 5.4  Delete production log ID=1
DELETE {{host}}/api/production-log/1

###


